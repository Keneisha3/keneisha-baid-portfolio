# Copy this file to .env and fill in what you have. Only the API key matters to start.

# Required for real research + app building (without it the studio runs in demo mode).
ANTHROPIC_API_KEY=

# Optional: deploy generated apps to Vercel instead of hosting them in the studio.
# Create one at https://vercel.com/account/tokens
VERCEL_TOKEN=

# Optional: the public URL of this studio. Apps deployed elsewhere send analytics here,
# so it must be reachable from the internet if you use Vercel deploys.
STUDIO_PUBLIC_URL=

# Optional settings
PORT=4321
# Use 0.0.0.0 to accept connections from other machines (only behind a login/proxy).
HOST=127.0.0.1
# Hours between automatic market pulses for launched ventures (0 = off).
PULSE_HOURS=24
# Model used for every stage.
STUDIO_MODEL=claude-opus-5-5
